# Cihazların şəbəkəsi və IP-lərin son rəqəmləri (hamısı eyni istifadəçi/şifrə ilə)
DEVICE_SUBNET=10.0.70
DEVICE_LAST_OCTETS=52,55,57,56,54,58,53,50,60,59,65,61,62,63,64

# İstəyə bağlı: tam IP siyahısı (yazılsa yuxarıdakıları əvəz edir)
DEVICE_IPS=
DEVICE_SCHEME=http
DEVICE_PORT=


DEVICE_USER=admin
DEVICE_PASSWORD=aztu2026
EVENT_PATH=/ISAPI/Event/notification/alertStream
DOOR_PATH=/ISAPI/AccessControl/RemoteControl/door/1
COOLDOWN_SECONDS=5
VERIFY_TLS=false
CARDS_FILE=cards.csv
# Cihazın saatı ilə PC saatı arasında bu qədər saniyədən köhnə hadisələr "tarixçə" sayılır və qapı açmır (0 = söndür)
MAX_EVENT_AGE_SECONDS=120
# Qapı yalnız bu majorEventType üçün açılır (5 = kart/üz/barmaq keçidi; 3 = əməliyyat logları, kart deyil)
CARD_MAJOR_TYPES=5
# İstəyə bağlı: yalnız bu subEventType-larda aç (məs. 1 = etibarlı kart). Boş = hamısı
OPEN_SUB_TYPES=
# Cihazın öz event loqunu (veb-interfeysdəki siyahı) oxuyur; alertStream bəzi hadisələri (məs. "Card Encryption Failed") göndərmir
POLL_ACS_EVENTS=true
POLL_INTERVAL_SECONDS=1.5
LOG_LEVEL=INFO
